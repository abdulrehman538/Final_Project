# Copy to .env and adjust for your machine.
# Django reads this file automatically from the project root.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=ecommerce_db
DB_USER=postgres
DB_PASSWORD=admin123!
DB_HOST=localhost
DB_PORT=5432

# Comma-separated regex patterns for React dev server origins
CORS_ALLOWED_ORIGIN_REGEXES=^http://localhost(:\d+)?$,^http://127\.0\.0\.1(:\d+)?$
